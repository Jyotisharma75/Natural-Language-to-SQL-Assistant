# Copy to .env and fill in. Never commit .env.
#
# Every value here is either a connection detail or a secret. Everything else
# lives in configs/*.yaml. Any setting can be overridden with an environment
# variable: NL2SQL_ plus the path, with two underscores between levels, for
# example NL2SQL_LIMITS__MAX_ROWS=500.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
NL2SQL_ENV=development

# ---------------------------------------------------------------------------
# Azure SQL: the database questions are answered from
# ---------------------------------------------------------------------------
NL2SQL_DATABASE__SERVER=your-server.database.windows.net
NL2SQL_DATABASE__DATABASE=your-database
NL2SQL_DATABASE__PORT=1433

# sql_password, entra_default, entra_managed_identity or entra_service_principal
NL2SQL_DATABASE__AUTH_MODE=sql_password
NL2SQL_DATABASE__USERNAME=nl2sql_reader

# The password itself, named by database.password_secret in configs/base.yaml.
NL2SQL_DB_PASSWORD=

# Set when using a user assigned managed identity.
# NL2SQL_DATABASE__MANAGED_IDENTITY_CLIENT_ID=

# The full URL instead of the fields above, for local work against SQLite:
# NL2SQL_DATABASE__URL=sqlite:///./data/demo.db

# ---------------------------------------------------------------------------
# Application database: audit and conversation tables, managed by Alembic
# ---------------------------------------------------------------------------
NL2SQL_APP_DATABASE__URL=sqlite:///./data/nl2sql_app.db
# In production, point this at a real database through a secret instead:
# NL2SQL_APP_DATABASE_URL=mssql+pyodbc:///?odbc_connect=...

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
NL2SQL_LLM__AZURE_OPENAI__ENDPOINT=https://your-resource.openai.azure.com
NL2SQL_LLM__AZURE_OPENAI__DEPLOYMENT=your-deployment-name
NL2SQL_LLM__AZURE_OPENAI__API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=

# Prefer managed identity in Azure, which needs no key at all:
# NL2SQL_LLM__AZURE_OPENAI__USE_MANAGED_IDENTITY=true

# ---------------------------------------------------------------------------
# Local Hugging Face model
# ---------------------------------------------------------------------------
NL2SQL_LLM__LOCAL__ENABLED=true
NL2SQL_LLM__LOCAL__MODEL_ID=Qwen/Qwen2.5-Coder-0.5B-Instruct
NL2SQL_LLM__LOCAL__DEVICE=cpu
NL2SQL_LLM__LOCAL__DTYPE=float32
# Where weights are cached. Mount this as a volume in a container.
# HF_HOME=./.hf_cache

# ---------------------------------------------------------------------------
# API authentication
# ---------------------------------------------------------------------------
# A JSON array of key entries. Use key_sha256 in production and key only for
# local work, where it is hashed on load.
#   [{"key_sha256": "<sha256 of the key>", "principal": "reporting-app",
#     "tenant_id": "acme", "roles": ["reader"]}]
NL2SQL_API_KEYS=[{"key":"local-development-key","principal":"local","roles":["reader","admin"]}]

# ---------------------------------------------------------------------------
# Security, when the schema supports it
# ---------------------------------------------------------------------------
# Required in production, as a JSON array:
# NL2SQL_SECURITY__ALLOWED_SCHEMAS=["dbo","reporting"]
# Tenant isolation, when your tables carry a tenant column:
# NL2SQL_TENANCY__ENABLED=true
# NL2SQL_TENANCY__TENANT_COLUMN_PATTERNS=["tenant_id","TenantId"]
# NL2SQL_TENANCY__SESSION_CONTEXT_KEY=tenant_id

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# Set to 1 to let the local model tests download and run the model.
# NL2SQL_RUN_LOCAL_MODEL_TESTS=1
